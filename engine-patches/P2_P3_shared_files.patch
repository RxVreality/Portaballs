+	/// <summary>
+	/// Portaballs patch P3. On: each eye sits half the eye distance either side of the head (the camera). Off: the
+	/// engine's own placement, a whole eye distance from the position passed in. SceneCamera.RenderStereo used to pass
+	/// the LEFT eye's position in for the right eye, so the two eyes came out the right distance apart but with the right
+	/// eye on the head and the left eye a whole eye distance to its left: the world was drawn 3.5 cm left of the head
+	/// (measured in the tester's Steam Frame, 2026-11-19: eyes 70.5 mm apart, one 0.0 mm and one 70.5 mm from the head).
+	/// </summary>
+	[ConVar( "vr_eyes_centred", Help = "Portaballs patch P3: place the two VR eyes half the eye distance either side of the head (off = the engine's original placement)." )]
+	internal static bool EyesCentred { get; set; } = true;
+
 	internal static Transform GetTransformForEye( Vector3 cameraPosition, Rotation cameraRotation, VREye eye )
 	{
 		var transform = new Transform();
 
-		var positionOffset = (eye == VREye.Left ? cameraRotation.Left : cameraRotation.Right) * IPD;
+		var positionOffset = (eye == VREye.Left ? cameraRotation.Left : cameraRotation.Right) * (EyesCentred ? IPD * 0.5f : IPD);
 		transform.Position = cameraPosition + positionOffset;
 		transform.Rotation = cameraRotation;
 		transform.Scale = 1.0f;
