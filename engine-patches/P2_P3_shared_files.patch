 		for ( int iEye = 0; iEye < 2; ++iEye )
 		{
 			bool isLeftEye = iEye == 0;
@@ -1136,7 +1144,9 @@ public sealed partial class SceneCamera : IDisposable, IManagedCamera
 			VRSystem.ClipPlanes.ZFar = ZFar;
 
